# ==============================================================================
# Amrita Yukti — Environment Variables Configuration
# ==============================================================================
# Set these variables in your local .env and in Vercel Project Settings.
# Never commit your real keys or credentials to version control.
# ==============================================================================

# Supabase Project URL (Client + Server)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase Anon / Public Key (Safe for client-side when RLS is enabled)
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase Service Role Key (SERVER-SIDE ONLY, NEVER prefix with VITE_)
# Bypasses RLS for backend administration, seeding, and secure operations
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Server Configuration
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Demo & AI Configuration
# Set DEMO_OFFLINE=true only if testing completely offline without Supabase
DEMO_OFFLINE=false
# Optional Gemini API key for chatbot low-confidence intent clarification (server-side only)
GEMINI_API_KEY=
# Optional Gemini model for intent classification fallback (default: gemini-2.5-flash)
GEMINI_MODEL=
# Password used by scripts/seed-demo-users.mjs
DEMO_PASSWORD=
