# ==============================================================================
# CampusSync — Environment Variables Configuration
# ==============================================================================
# In Vercel Project Settings -> Environment Variables, add these keys if using
# Supabase Cloud Database. If left blank, CampusSync automatically operates
# with its resilient in-memory fallback store so your app never fails.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=
SUPABASE_URL=

# Supabase Anon / Public API Key
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Supabase Service Role Key (Optional, for backend admin privileges)
SUPABASE_SERVICE_ROLE_KEY=

# Local Port (default 5000)
PORT=5000
